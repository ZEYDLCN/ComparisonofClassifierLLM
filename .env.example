# Bu dosyayı ".env" adıyla kopyalayın ve yalnızca kullanmak istediğiniz servislerin anahtarlarını doldurun.
# Boş bırakılan servis otomatik atlanır. ".env" dosyası .gitignore'dadır, asla commit'lenmez.
# Anahtarın nereden alınacağı: `python -m clfbench keys`  veya README.md

# --- Üretken LLM'ler ---
ANTHROPIC_API_KEY=        # Claude Haiku 5.5 / Sonnet 5.5 / Opus 5.5
GEMINI_API_KEY=           # Gemini 3.5 Flash-Lite / 3.8 Flash
OPENROUTER_API_KEY=       # GPT-6 Luna (sohbet), DeepSeek V4 Flash, Qwen3.8 Flash

# --- Karar (classifier) API'leri ---
OPENAI_API_KEY=           # OpenAI Decisions (gpt-6-luna) — public beta
INCEPTION_API_KEY=        # Mercury Decide + Mercury 2.5 (yeni kullanıcıya ücretsiz token)
LIQUID_API_KEY=           # Liquid d1
TYPESAFE_API_KEY=         # Jev
ZOODATA_API_KEY=          # Instinct (en az 20 USD yükleme)

# --- İsteğe bağlı / doğrulanmamış şablon girdiler (configs/models.yaml'da enabled: false) ---
LEVANTO_API_KEY=          # Sage
FOUNDRY_API_KEY=          # Microsoft-Decision-1
